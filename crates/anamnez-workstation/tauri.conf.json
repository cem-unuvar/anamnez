{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anamnez",
  "version": "0.0.0",
  "identifier": "org.anamnez.workstation",
  "build": {
    "frontendDist": "../anamnez-workstation-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../anamnez-workstation-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../anamnez-workstation-ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "anamnez",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-first clinical records workstation",
    "longDescription": "Tauri + Leptos workstation client for the anamnez clinical records appliance."
  }
}
